<?xml version="1.0" encoding="utf-8"?>
<!--
  GENERATED — the <receiver> the Tapp build hook merges into unityLibrary's AndroidManifest.xml, once per
  widget id. Re-staged on every build; edits in the Gradle project are lost.

  `com.tappgo.sdk.WIDGET_ID` is a LITERAL, never `@string/…`: the manifest compiler stores a resource
  reference as an id, and the SDK reads this key as text. It is what tells the SDK which configured
  campaign a tap on this receiver belongs to.

  Tokens substituted at stage time:
    __TAPP_PROVIDER_CLASS__   the staged provider class this receiver names
    __TAPP_WIDGET_ID__        the campaign it serves
-->
<receiver xmlns:android="http://schemas.android.com/apk/res/android"
    android:name="com.tappgo.unity.__TAPP_PROVIDER_CLASS__"
    android:label="@string/tapp_widget_label"
    android:exported="false">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
    </intent-filter>
    <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/tapp_widget_info" />
    <meta-data
        android:name="com.tappgo.sdk.WIDGET_ID"
        android:value="__TAPP_WIDGET_ID__" />
</receiver>
